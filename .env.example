SA_PASSWORD=
JWT_SIGNING_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=

# E-mail (compose.yaml → Smtp__*). Left out, the API sends to the local Mailpit (http://localhost:8025):
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_ENABLE_SSL=false  SMTP_FROM=zev-platforma@localhost
#
# Real Gmail delivery: uncomment and fill in. SMTP_PASSWORD is a Google *App Password* (Google account →
# Security → 2-Step Verification → App passwords), not the account password. Use port 587 (STARTTLS);
# 465 is not supported by the API's SMTP client.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_ENABLE_SSL=true
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=your.address@gmail.com
