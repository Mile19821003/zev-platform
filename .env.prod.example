# Copy to .env.prod (chmod 600, never commit). Used by compose.prod.yaml and scripts/*.sh.
# Passwords: at least 12 chars with upper, lower, digit and symbol; no ' or ] characters.

# Public host name served by Caddy, and TLS mode: an e-mail address for Let's Encrypt (public DNS + ports 80/443)
# or "internal" for a self-signed CA (testing only).
ZEV_DOMAIN=zev.example.com
ZEV_TLS=ops@example.com

# SQL Server: sa is used only by the migrate step and the ops scripts; the API uses APP_DB_LOGIN.
# MSSQL_PID must match your license:
#   production: Standard or Enterprise (or the product key)
#   staging:    Developer (free, not licensed for production) or Express
# Express cannot compress backups (scripts/backup.sh falls back to uncompressed and logs it) and limits databases to 10 GB.
SA_PASSWORD=
MSSQL_PID=Standard
APP_DB_LOGIN=zev_app
APP_DB_PASSWORD=

# API secrets. Bootstrap creates the first system administrator once; remove after first login.
JWT_SIGNING_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: host ports, internal network, proxy address (must lie in the subnet), volume name prefix.
# ZEV_HTTP_PORT=80
# ZEV_HTTPS_PORT=443
# ZEV_SUBNET=172.28.0.0/24
# ZEV_PROXY_IP=172.28.0.10
# ZEV_VOLUME_PREFIX=zev
